# generate_test.py
import os
import sys
import getpass
import git
import keyring
try:
    import tomllib  # Python 3.11+
except ImportError:
    import tomli as tomllib  # pip install tomli

CONFIG_FILE = "config.toml"

def load_config():
    if not os.path.exists(CONFIG_FILE):
        print(f"Конфиг-файл {CONFIG_FILE} не найден!")
        sys.exit(1)
    with open(CONFIG_FILE, "rb") as f:
        return tomllib.load(f)

def get_credentials(service):
    username = keyring.get_password(service, "username")
    password = keyring.get_password(service, "password")
    
    if not username:
        username = input(f"Логин {service}: ")
        keyring.set_password(service, "username", username)
    
    if not password:
        password = getpass.getpass(f"Пароль {service}: ")
        keyring.set_password(service, "password", password)
    
    return username, password

def generate_test_py_content(schema, table_name, keys_str, config):
    keys_list = [k.strip() for k in keys_str.split(',')]
    group_by = ', '.join(keys_list)
    
    dsn = config["database"]["default_dsn"]
    
    content = f'''\
import os
import pytest
import allure
import oracledb

DB_DSN = os.getenv("DB_DSN", "{dsn}")

@allure.title("Проверка дубликатов в таблице {table_name}")
@allure.description("Ключи: {group_by}")
def test_no_duplicates_{table_name.lower().replace('.', '_')}():
    user = os.getenv("DB_USER")
    password = os.getenv("DB_PASS")
    
    if not user or not password:
        pytest.fail("Переменные окружения DB_USER / DB_PASS не установлены")
    
    with allure.step("Подключение к базе"):
        conn = oracledb.connect(user=user, password=password, dsn=DB_DSN)
        cursor = conn.cursor()
    
    sql = """
SELECT {group_by}, COUNT(*)
FROM {schema}.{table_name}
GROUP BY {group_by}
HAVING COUNT(*) > 1
""".strip()
    
    with allure.step("Выполнение запроса"):
        cursor.execute(sql)
        rows = cursor.fetchall()
    
    with allure.step("Анализ результата"):
        if rows:
            for row in rows:
                allure.attach(str(row), name="Дубликат", attachment_type=allure.attachment_type.TEXT)
            pytest.fail(f"Найдено {{len(rows)}} наборов дубликатов")
        else:
            allure.step("Дубликатов не обнаружено → OK")
    
    conn.close()
'''
    return content.strip()

def main():
    config = load_config()
    
    print("=== Генерация теста на дубликаты ===\n")
    
    schema = input("Схема: ").strip()
    table_name = input("Таблица: ").strip()
    keys = input("Ключи (через запятую): ").strip()
    
    test_content = generate_test_py_content(schema, table_name, keys, config)
    
    tests_dir = config["tests"]["tests_directory"]
    prefix = config["tests"]["test_file_prefix"]
    ext = config["tests"]["file_extension"]
    filename = f"{prefix}{table_name.lower().replace('.', '_')}{ext}"
    relative_path = f"{tests_dir}/{filename}"
    full_path = os.path.join(config["repository"]["local_path"], relative_path)
    
    branch_name = input("\nИмя ветки: ").strip()
    
    print("\nСгенерированный тест:\n" + "="*70)
    print(test_content)
    print("="*70)
    
    if config["behavior"].get("confirm_before_push", True):
        if not input("\nЗапушить в репозиторий? [y/N]: ").lower().startswith('y'):
            return
    
    # ─── Git ────────────────────────────────────────────────
    git_user, git_pass = get_credentials(config["repository"]["git_service_name"])
    
    repo_path = config["repository"]["local_path"]
    if not os.path.exists(repo_path):
        auth_url = f"https://{git_user}:{git_pass}@{config['repository']['url'].split('https://')[1]}"
        git.Repo.clone_from(auth_url, repo_path)
        print("Репозиторий склонирован")
    
    repo = git.Repo(repo_path)
    
    os.makedirs(os.path.dirname(full_path), exist_ok=True)
    with open(full_path, 'w', encoding='utf-8') as f:
        f.write(test_content)
    
    repo.remotes.origin.fetch()
    
    if config["behavior"].get("auto_stash", True) and (repo.is_dirty() or repo.untracked_files):
        print("→ Авто-stash")
        repo.git.stash('push', '-m', f"auto-stash before {branch_name}")
    
    remote_branches = {ref.name.split('/')[-1] for ref in repo.remotes.origin.refs}
    
    if branch_name in remote_branches:
        repo.git.checkout(branch_name)
        repo.git.pull('origin', branch_name)
    else:
        repo.git.checkout(config["repository"]["default_branch"])
        repo.git.pull('origin', config["repository"]["default_branch"])
        repo.git.checkout('-b', branch_name)
    
    repo.git.add(relative_path)
    repo.index.commit(f"Add duplicate check: {schema}.{table_name}")
    repo.git.push('--set-upstream', 'origin', branch_name)
    
    print(f"\nГотово! Тест в ветке: {branch_name}")
    print(f"Файл: {relative_path}")

if __name__ == "__main__":
    main()
