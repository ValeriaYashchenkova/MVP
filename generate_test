# generate_test.py
import os
import getpass
import git
import keyring

# ──────────────────────────────────────────────
# Константы
# ──────────────────────────────────────────────
REPO_URL = "https://git.moscow.alfaintra.net/scm/bialm_ft/bialm_ft_auto.git"
LOCAL_REPO_PATH = "./bialm_ft_auto"
GIT_SERVICE = "bitbucket_auto_tests"
DEFAULT_BRANCH = "master"

def get_credentials(service):
    username = keyring.get_password(service, "username")
    password = keyring.get_password(service, "password")
    
    if not username:
        username = input(f"Логин Bitbucket ({service}): ")
        keyring.set_password(service, "username", username)
    
    if not password:
        password = getpass.getpass(f"Пароль Bitbucket ({service}): ")
        keyring.set_password(service, "password", password)
    
    return username, password

def generate_test_py_content(schema, table_name, keys_str):
    keys_list = [k.strip() for k in keys_str.split(',')]
    group_by = ', '.join(keys_list)
    
    content = f'''\
import os
import pytest
import allure
import oracledb

DB_DSN = os.getenv("DB_DSN", "(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=VMDWH12)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=ALMTST1)))")

@allure.title("Проверка дубликатов в таблице {table_name}")
@allure.description("Ключи: {group_by}")
def test_no_duplicates_in_{table_name.replace('.', '_')}():
    user = os.getenv("DB_USER")
    password = os.getenv("DB_PASS")
    
    if not user or not password:
        pytest.fail("Переменные окружения DB_USER / DB_PASS не установлены")
    
    with allure.step("Подключение к базе"):
        conn = oracledb.connect(user=user, password=password, dsn=DB_DSN)
        cursor = conn.cursor()
    
    sql = """
SELECT {group_by}, COUNT(*)
FROM {schema}.{table_name}
GROUP BY {group_by}
HAVING COUNT(*) > 1
""".strip()
    
    with allure.step("Выполнение запроса"):
        cursor.execute(sql)
        rows = cursor.fetchall()
    
    with allure.step("Проверка результата"):
        if rows:
            for row in rows:
                allure.attach(str(row), name="Дубликат", attachment_type=allure.attachment_type.TEXT)
            pytest.fail(f"Найдено {{len(rows)}} наборов дубликатов")
        else:
            allure.step("Дубликатов не обнаружено")
    
    conn.close()
'''
    return content.strip()

def main():
    print("=== Генерация теста на дубликаты ===\n")
    
    schema = input("Схема: ").strip()
    table_name = input("Таблица: ").strip()
    keys = input("Ключи через запятую: ").strip()
    
    test_content = generate_test_py_content(schema, table_name, keys)
    
    test_filename = f"test_duplicates_{table_name.lower().replace('.', '_')}.py"
    relative_path = f"tests/{test_filename}"
    full_path = os.path.join(LOCAL_REPO_PATH, relative_path)
    
    branch_name = input("\nИмя ветки (feature/... или bugfix/...): ").strip()
    
    print("\nСгенерированный код теста:\n" + "="*60)
    print(test_content)
    print("="*60)
    
    confirm = input("\nСохранить и запушить? [y/N]: ").lower().startswith('y')
    if not confirm:
        return
    
    # ─── Git операции ────────────────────────────────────────
    git_user, git_pass = get_credentials(GIT_SERVICE)
    
    if not os.path.exists(LOCAL_REPO_PATH):
        auth_url = f"https://{git_user}:{git_pass}@{REPO_URL.split('https://')[1]}"
        git.Repo.clone_from(auth_url, LOCAL_REPO_PATH)
        print("Репозиторий склонирован")
    
    repo = git.Repo(LOCAL_REPO_PATH)
    
    os.makedirs(os.path.dirname(full_path), exist_ok=True)
    with open(full_path, 'w', encoding='utf-8') as f:
        f.write(test_content)
    
    repo.remotes.origin.fetch()
    
    # Авто-stash если нужно
    if repo.is_dirty() or repo.untracked_files:
        print("→ Автоматический stash текущих изменений")
        repo.git.stash('push', '-m', f"auto-stash before {branch_name}")
    
    remote_branches = {ref.name.split('/')[-1] for ref in repo.remotes.origin.refs}
    
    if branch_name in remote_branches:
        repo.git.checkout(branch_name)
        repo.git.pull('origin', branch_name)
    else:
        repo.git.checkout(DEFAULT_BRANCH)
        repo.git.pull('origin', DEFAULT_BRANCH)
        repo.git.checkout('-b', branch_name)
    
    repo.git.add(relative_path)
    repo.index.commit(f"Add duplicate check test for {schema}.{table_name}")
    repo.git.push('--set-upstream', 'origin', branch_name)
    
    print(f"\nГотово! Тест добавлен в ветку → {branch_name}")
    print(f"Путь в репозитории: {relative_path}")

if __name__ == "__main__":
    main()
