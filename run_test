# run_test.py
import os
import sys
import oracledb
import keyring
import git
import datetime
import webbrowser
try:
    import tomllib
except ImportError:
    import tomli as tomllib

CONFIG_FILE = "config.toml"

def load_config():
    if not os.path.exists(CONFIG_FILE):
        print(f"Конфиг {CONFIG_FILE} не найден!")
        sys.exit(1)
    with open(CONFIG_FILE, "rb") as f:
        return tomllib.load(f)

def get_db_credentials(config):
    service = config["database"]["db_service_name"]
    user = keyring.get_password(service, "username")
    password = keyring.get_password(service, "password")
    
    if not user:
        user = input(f"Логин БД ({service}): ")
        keyring.set_password(service, "username", user)
    
    if not password:
        password = getpass.getpass(f"Пароль БД ({service}): ")
        keyring.set_password(service, "password", password)
    
    return user, password

def checkout_and_pull_branch(repo, branch_name, default_branch):
    repo.remotes.origin.fetch()
    remote_branches = {ref.name.split('/')[-1] for ref in repo.remotes.origin.refs}
    
    if branch_name not in remote_branches:
        print(f"Ветка '{branch_name}' не найдена")
        print("Доступные:", ", ".join(sorted(remote_branches)) or "— пусто —")
        sys.exit(1)
    
    print(f"→ checkout {branch_name}")
    repo.git.checkout(branch_name)
    print(f"→ pull origin/{branch_name}")
    repo.git.pull('origin', branch_name)

def run_sql_file(db_user, db_pass, dsn, sql_path):
    try:
        conn = oracledb.connect(user=db_user, password=db_pass, dsn=dsn)
        cursor = conn.cursor()
        with open(sql_path, 'r', encoding='utf-8') as f:
            sql = f.read()
        cursor.execute(sql)
        rows = cursor.fetchall()
        conn.close()
        
        if len(rows) == 0:
            return "OK", "Дубликатов не найдено", ""
        else:
            details = []
            for row in rows:
                details.append(str(row))
            return "FAILED", f"Найдено {len(rows)} наборов дубликатов", "\n".join(details)
    
    except oracledb.Error as e:
        return "ERROR", "Ошибка выполнения", str(e)

def generate_html_report(results, branch_name):
    timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    html = f"""<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Отчёт по проверке дубликатов — {branch_name}</title>
    <style>
        body {{ font-family: Arial, sans-serif; margin: 40px; background: #f9f9f9; }}
        h1 {{ color: #2c3e50; }}
        table {{ border-collapse: collapse; width: 100%; max-width: 1100px; margin-top: 20px; }}
        th, td {{ border: 1px solid #bdc3c7; padding: 14px; text-align: left; }}
        th {{ background: #ecf0f1; color: #34495e; }}
        .ok    {{ background: #d4edda; color: #155724; font-weight: bold; }}
        .fail  {{ background: #f8d7da; color: #721c24; font-weight: bold; }}
        .error {{ background: #fff3cd; color: #856404; font-weight: bold; }}
        pre {{ margin: 0; white-space: pre-wrap; font-family: Consolas, monospace; }}
    </style>
</head>
<body>
    <h1>Отчёт по проверке дубликатов</h1>
    <p>Ветка: <strong>{branch_name}</strong><br>
       Дата: {timestamp}<br>
       Всего проверок: {len(results)}</p>
    
    <table>
        <tr>
            <th>Файл скрипта</th>
            <th>Статус</th>
            <th>Сообщение</th>
            <th>Детали / Дубликаты</th>
        </tr>
"""
    for r in results:
        cls = {"OK": "ok", "FAILED": "fail", "ERROR": "error"}[r["status"]]
        details = r["details"] or "—"
        html += f"""        <tr>
            <td>{r["file"]}</td>
            <td class="{cls}">{r["status"]}</td>
            <td>{r["message"]}</td>
            <td><pre>{details}</pre></td>
        </tr>\n"""
    
    html += """    </table>
</body>
</html>"""
    return html

def main():
    config = load_config()
    repo_path = config["repository"]["local_path"]
    
    if not os.path.exists(repo_path):
        print("Репозиторий не найден. Запустите generate_test.py")
        sys.exit(1)
    
    repo = git.Repo(repo_path)
    
    print("=== Проверка дубликатов по SQL-скриптам ===\n")
    
    branch_name = input("Название ветки: ").strip()
    if not branch_name:
        return
    
    checkout_and_pull_branch(repo, branch_name, config["repository"]["default_branch"])
    
    tests_dir = os.path.join(repo_path, config["tests"]["tests_directory"])
    if not os.path.exists(tests_dir):
        print(f"Папка {tests_dir} не найдена")
        return
    
    sql_files = [f for f in os.listdir(tests_dir) if f.endswith('.sql')]
    if not sql_files:
        print(f"SQL-скрипты не найдены в {tests_dir}")
        return
    
    print(f"Найдено скриптов: {len(sql_files)}")
    for f in sql_files:
        print(f"  • {f}")
    
    db_user, db_pass = get_db_credentials(config)
    dsn = config["database"]["default_dsn"]
    
    results = []
    
    print("\nВыполняю проверки...\n")
    
    for sql_file in sql_files:
        sql_path = os.path.join(tests_dir, sql_file)
        print(f"→ {sql_file} ... ", end="")
        status, message, details = run_sql_file(db_user, db_pass, dsn, sql_path)
        results.append({
            "file": sql_file,
            "status": status,
            "message": message,
            "details": details
        })
        print(status)
    
    html_content = generate_html_report(results, branch_name)
    report_path = os.path.join(os.path.dirname(__file__), f"report_{branch_name.replace('/', '_')}.html")
    
    with open(report_path, "w", encoding="utf-8") as f:
        f.write(html_content)
    
    print(f"\nОтчёт сохранён: {report_path}")
    print("Открываю в браузере...")
    webbrowser.open(f"file:///{os.path.abspath(report_path)}")

if __name__ == "__main__":
    main()
