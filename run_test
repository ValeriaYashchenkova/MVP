# run_test.py
import os
import subprocess
import getpass
import keyring
import sys
try:
    import tomllib
except ImportError:
    import tomli as tomllib

CONFIG_FILE = "config.toml"

def load_config():
    if not os.path.exists(CONFIG_FILE):
        print(f"Конфиг {CONFIG_FILE} не найден!")
        sys.exit(1)
    with open(CONFIG_FILE, "rb") as f:
        return tomllib.load(f)

def get_db_credentials(config):
    service = config["database"]["db_service_name"]
    user = keyring.get_password(service, "username")
    password = keyring.get_password(service, "password")
    
    if not user:
        user = input("Логин БД: ")
        keyring.set_password(service, "username", user)
    
    if not password:
        password = getpass.getpass("Пароль БД: ")
        keyring.set_password(service, "password", password)
    
    return user, password

def main():
    config = load_config()
    
    print("=== Запуск теста на дубликаты ===\n")
    
    test_file = input("Имя файла теста (например test_duplicates_xxx.py): ").strip()
    if not test_file.startswith(config["tests"]["tests_directory"] + "/"):
        test_file = f"{config['tests']['tests_directory']}/{test_file}"
    
    full_test_path = os.path.join(config["repository"]["local_path"], test_file)
    
    if not os.path.exists(full_test_path):
        print(f"Файл не найден: {full_test_path}")
        return
    
    user, password = get_db_credentials(config)
    
    env = os.environ.copy()
    env["DB_USER"] = user
    env["DB_PASS"] = password
    # env["DB_DSN"] = config["database"]["default_dsn"]  # если нужно переопределить
    
    allure_results = config["allure"]["results_dir"]
    os.makedirs(allure_results, exist_ok=True)
    
    print("\nЗапуск pytest...\n")
    
    try:
        result = subprocess.run(
            [
                "pytest",
                "--alluredir", allure_results,
                full_test_path
            ],
            env=env,
            capture_output=True,
            text=True
        )
        
        print(result.stdout)
        if result.stderr:
            print("\nstderr:\n" + result.stderr)
        
        print(f"\nКод возврата: {result.returncode}")
        print("OK ✓" if result.returncode == 0 else "Провал ✗")
        
        print(f"\nПросмотр отчёта: allure serve {allure_results}")
    
    except FileNotFoundError:
        print("pytest не найден → pip install pytest allure-pytest")
    except Exception as e:
        print(f"Ошибка запуска: {e}")

if __name__ == "__main__":
    main()
