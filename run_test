# run_test.py
import os
import sys
import subprocess
import getpass
import keyring
import git
import datetime
import webbrowser
try:
    import tomllib
except ImportError:
    import tomli as tomllib

CONFIG_FILE = "config.toml"

def load_config():
    if not os.path.exists(CONFIG_FILE):
        print(f"Конфиг {CONFIG_FILE} не найден!")
        sys.exit(1)
    with open(CONFIG_FILE, "rb") as f:
        return tomllib.load(f)

def get_db_credentials(config):
    service = config["database"]["db_service_name"]
    user = keyring.get_password(service, "username")
    password = keyring.get_password(service, "password")
    
    if not user:
        user = input(f"Логин БД ({service}): ")
        keyring.set_password(service, "username", user)
    
    if not password:
        password = getpass.getpass(f"Пароль БД ({service}): ")
        keyring.set_password(service, "password", password)
    
    return user, password

def checkout_and_pull_branch(repo, branch_name, default_branch):
    repo.remotes.origin.fetch()
    remote_branches = {ref.name.split('/')[-1] for ref in repo.remotes.origin.refs}
    
    if branch_name not in remote_branches:
        print(f"Ветка '{branch_name}' не найдена")
        print("Доступные:", ", ".join(sorted(remote_branches)) or "— пусто —")
        sys.exit(1)
    
    print(f"→ checkout {branch_name}")
    repo.git.checkout(branch_name)
    print(f"→ pull origin/{branch_name}")
    repo.git.pull('origin', branch_name)

def parse_pytest_output(output):
    """Простой парсер вывода pytest для извлечения результатов"""
    lines = output.splitlines()
    results = []
    current_test = None
    
    for line in lines:
        line = line.strip()
        if line.startswith("test_") and "::" in line:
            current_test = line.split("::")[-1].split()[0]
        elif line.startswith("PASSED") and current_test:
            results.append({"name": current_test, "status": "PASSED", "message": ""})
            current_test = None
        elif line.startswith("FAILED") and current_test:
            # ищем сообщение об ошибке (следующая строка часто содержит детали)
            msg = ""
            for next_line in lines[lines.index(line)+1:]:
                if next_line.strip() and not next_line.startswith(" "):
                    break
                msg += next_line.strip() + " "
            results.append({"name": current_test, "status": "FAILED", "message": msg.strip()})
            current_test = None
        elif line.startswith("ERROR") and current_test:
            results.append({"name": current_test, "status": "ERROR", "message": "Ошибка выполнения"})
            current_test = None
    
    return results

def generate_html_report(results, branch_name):
    timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    html = f"""<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Отчёт по проверке дубликатов — {branch_name}</title>
    <style>
        body {{ font-family: Arial, sans-serif; margin: 40px; }}
        h1 {{ color: #333; }}
        table {{ border-collapse: collapse; width: 100%; max-width: 900px; }}
        th, td {{ border: 1px solid #ddd; padding: 12px; text-align: left; }}
        th {{ background-color: #f2f2f2; }}
        .passed {{ background-color: #d4edda; color: #155724; }}
        .failed {{ background-color: #f8d7da; color: #721c24; }}
        .error  {{ background-color: #fff3cd; color: #856404; }}
        pre {{ white-space: pre-wrap; font-family: monospace; }}
    </style>
</head>
<body>
    <h1>Отчёт по тестам на дубликаты</h1>
    <p>Ветка: <strong>{branch_name}</strong><br>
       Дата: {timestamp}<br>
       Всего тестов: {len(results)}</p>
    
    <table>
        <tr>
            <th>Тест</th>
            <th>Статус</th>
            <th>Сообщение / Детали</th>
        </tr>
"""
    for r in results:
        cls = r["status"].lower()
        msg = r["message"] or "—"
        html += f"""        <tr>
            <td>{r["name"]}</td>
            <td class="{cls}"><strong>{r["status"]}</strong></td>
            <td><pre>{msg}</pre></td>
        </tr>\n"""
    
    html += """    </table>
</body>
</html>"""
    return html

def main():
    config = load_config()
    repo_path = config["repository"]["local_path"]
    
    if not os.path.exists(repo_path):
        print("Репозиторий не найден. Запустите generate_test.py сначала.")
        sys.exit(1)
    
    repo = git.Repo(repo_path)
    
    print("=== Запуск тестов и генерация простого отчёта ===\n")
    
    branch_name = input("Название ветки: ").strip()
    if not branch_name:
        return
    
    checkout_and_pull_branch(repo, branch_name, config["repository"]["default_branch"])
    
    tests_dir = os.path.join(repo_path, config["tests"]["tests_directory"])
    if not os.path.exists(tests_dir):
        print(f"Папка тестов не найдена: {tests_dir}")
        return
    
    user, password = get_db_credentials(config)
    
    env = os.environ.copy()
    env["DB_USER"] = user
    env["DB_PASS"] = password
    
    print("\nЗапускаю pytest...\n")
    
    try:
        result = subprocess.run(
            ["pytest", tests_dir],
            env=env,
            capture_output=True,
            text=True,
            cwd=repo_path
        )
        
        print(result.stdout)
        if result.stderr:
            print("\nОшибки/логи:\n" + result.stderr)
        
        print(f"\nКод возврата: {result.returncode}")
        
        # Парсим результаты
        test_results = parse_pytest_output(result.stdout + "\n" + result.stderr)
        
        if not test_results:
            print("Не удалось распознать результаты тестов (возможно, pytest упал слишком рано)")
            print("Сохраняем сырой вывод в raw_output.txt")
            with open("raw_output.txt", "w", encoding="utf-8") as f:
                f.write(result.stdout + "\n\n" + result.stderr)
            return
        
        # Генерируем HTML
        html_content = generate_html_report(test_results, branch_name)
        report_path = "test_report.html"
        
        with open(report_path, "w", encoding="utf-8") as f:
            f.write(html_content)
        
        print(f"\nОтчёт сохранён: {report_path}")
        print("Открываю в браузере...")
        webbrowser.open(f"file://{os.path.abspath(report_path)}")
    
    except FileNotFoundError:
        print("pytest не найден → pip install pytest")
    except Exception as e:
        print(f"Ошибка при запуске: {e}")

if __name__ == "__main__":
    main()
