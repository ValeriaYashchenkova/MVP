# run_test.py
import os
import subprocess
import sys
import getpass
import keyring
import git
try:
    import tomllib
except ImportError:
    import tomli as tomllib

CONFIG_FILE = "config.toml"

def load_config():
    if not os.path.exists(CONFIG_FILE):
        print(f"Конфиг {CONFIG_FILE} не найден!")
        sys.exit(1)
    with open(CONFIG_FILE, "rb") as f:
        return tomllib.load(f)

def get_db_credentials(config):
    service = config["database"]["db_service_name"]
    user = keyring.get_password(service, "username")
    password = keyring.get_password(service, "password")
    
    if not user:
        user = input(f"Логин БД ({service}): ")
        keyring.set_password(service, "username", user)
    
    if not password:
        password = getpass.getpass(f"Пароль БД ({service}): ")
        keyring.set_password(service, "password", password)
    
    return user, password

def checkout_and_pull_branch(repo, branch_name, default_branch):
    repo.remotes.origin.fetch()
    
    remote_branches = {ref.name.split('/')[-1] for ref in repo.remotes.origin.refs}
    
    if branch_name not in remote_branches:
        print(f"Ветка '{branch_name}' не найдена в удалённом репозитории")
        print("Доступные ветки:", ", ".join(sorted(remote_branches)) if remote_branches else "— пусто —")
        sys.exit(1)
    
    print(f"Переключаемся на ветку: {branch_name}")
    repo.git.checkout(branch_name)
    
    print(f"Подтягиваем изменения из origin/{branch_name}")
    repo.git.pull('origin', branch_name)

def main():
    config = load_config()
    repo_path = config["repository"]["local_path"]
    
    if not os.path.exists(repo_path):
        print(f"Локальный репозиторий не найден: {repo_path}")
        print("Сначала запустите generate_test.py чтобы склонировать репозиторий")
        sys.exit(1)
    
    repo = git.Repo(repo_path)
    
    print("=== Запуск тестов с ветки ===\n")
    
    branch_name = input("Название ветки для запуска тестов: ").strip()
    if not branch_name:
        print("Ветка не указана → выход")
        return
    
    # Переключаемся на нужную ветку
    checkout_and_pull_branch(repo, branch_name, config["repository"]["default_branch"])
    
    # Путь к директории с тестами
    tests_dir = os.path.join(repo_path, config["tests"]["tests_directory"])
    
    if not os.path.exists(tests_dir):
        print(f"Директория с тестами не найдена: {tests_dir}")
        return
    
    # Собираем все .py файлы в tests/
    test_files = [f for f in os.listdir(tests_dir) if f.endswith('.py') and f.startswith(config["tests"]["test_file_prefix"])]
    
    if not test_files:
        print(f"Тесты не найдены в {tests_dir}")
        print("Ожидаемые файлы начинаются с:", config["tests"]["test_file_prefix"])
        return
    
    print(f"Найдено тестов: {len(test_files)}")
    for tf in test_files:
        print(f"  • {tf}")
    
    print("\nПродолжить запуск? [Y/n]")
    if input().strip().lower() in ('n', 'no'):
        return
    
    # Получаем credentials БД
    user, password = get_db_credentials(config)
    
    env = os.environ.copy()
    env["DB_USER"] = user
    env["DB_PASS"] = password
    # env["DB_DSN"] = ...  # если нужно переопределить — берётся из config в тестах
    
    allure_results = config["allure"]["results_dir"]
    os.makedirs(allure_results, exist_ok=True)
    
    print("\nЗапускаю pytest на всех тестах ветки...\n")
    
    try:
        cmd = [
            "pytest",
            "--alluredir", allure_results,
            os.path.join(tests_dir, "*.py")   # запуск всех .py файлов в директории
        ]
        
        result = subprocess.run(
            cmd,
            env=env,
            capture_output=True,
            text=True,
            cwd=repo_path   # важно — pytest запускается из корня репозитория
        )
        
        print(result.stdout)
        if result.stderr:
            print("\nstderr:\n" + result.stderr)
        
        print(f"\nКод возврата: {result.returncode}")
        print("Все тесты пройдены ✓" if result.returncode == 0 else "Есть проваленные тесты ✗")
        
        print(f"\nПросмотр Allure-отчёта:")
        print(f"  allure serve {allure_results}")
    
    except FileNotFoundError:
        print("pytest не найден → выполните: pip install pytest allure-pytest")
    except Exception as e:
        print(f"Ошибка при запуске pytest: {e}")

if __name__ == "__main__":
    main()
